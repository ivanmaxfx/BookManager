{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=bookingsdb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "BookManager-Sprint9-Development-Secret-Key-Change-In-Production",
    "Issuer": "BookManager",
    "Audience": "BookManager.Client"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "BookingProcessing": {
    "PollIntervalMilliseconds": 1000,
    "ProcessingDelayMilliseconds": 2000
  },
  "Service": {
    "Name": "bookings-service"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
